# Copy these into Railway > Variables
# ---- MODE ----
PAPER_TRADING=true
LIVE_TRADING_CONFIRM=no

# ---- COINBASE KEYS (live only; View + Trade permissions, NOT Transfer) ----
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ---- MONEY RULES ----
PRODUCTS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,LINK-USD,AVAX-USD,LTC-USD,DOGE-USD,ADA-USD,DOT-USD
TRADE_SIZE_USD=25
MAX_OPEN_POSITIONS=4
MAX_DAILY_LOSS_USD=5

# ---- EXITS ----
STOP_LOSS_PCT=15.0
TAKE_PROFIT_PCT=0
TRAIL_ACTIVATE_PCT=3.0
TRAILING_STOP_PCT=1.0
FEE_RATE_PCT=0.6
COOLDOWN_MIN=1440
EXIT_ON_TREND_FLIP=false
STALE_HOURS=48
STALE_BAND_PCT=1.0

# ---- TIMING / STRATEGY ----
CHECK_INTERVAL_MIN=10
CANDLE_GRANULARITY=FIVE_MINUTE
FAST_EMA=9
SLOW_EMA=21
TREND_EMA=100
RSI_MAX=70
MARKET_FILTER=BTC-USD
MAX_SPREAD_PCT=0.3

PAPER_START_USD=200
TIMEZONE=America/Los_Angeles
DATA_DIR=/data
